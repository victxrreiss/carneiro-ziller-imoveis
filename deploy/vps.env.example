# .env de PRODUÇÃO na VPS: ~/projetos/clientes/carneiro-ziller/site/.env (chmod 600).
# Nunca versionado. O deploy.sh o lê com `source`: valor com espaço ou &, entre aspas simples.
# Gere os segredos com: openssl rand -hex 32

SITE_URL=https://carneiroziller.com.br
SITE_DOMINIO=carneiroziller.com.br

POSTGRES_PASSWORD=
# Credencial do MinIO (dono do bucket cz-fotos); o site usa a mesma.
S3_ACCESS_KEY_ID=carneiroziller
S3_SECRET_ACCESS_KEY=

# Protege /api/cron/limpeza (chamada pelo cron da VPS, deploy/cron-limpeza.sh).
CRON_SECRET=

# --- E-mail (SMTP) --- opcional até haver conta. Sem ele o site e o painel
# funcionam; só convites, redefinição de senha e avisos de interesse não saem.
# SMTP_HOST=smtp.resend.com
# SMTP_PORTA=465
# SMTP_SEGURO=true
# SMTP_USUARIO=resend
# SMTP_SENHA=
# EMAIL_DE='Carneiro & Ziller <painel@DOMINIO>'
# LEADS_EMAIL=
