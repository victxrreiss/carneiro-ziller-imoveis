# Valores do ambiente LOCAL (docker-compose.yml). São credenciais de container
# de desenvolvimento, não de produção. Copie para `.env.local` (ignorado pelo git):
#   cp .env.example .env.local
# Em produção (Vercel), as integrações Neon e Blob injetam banco e fotos sozinhas;
# o resto está em docs/backend-pendencias.md.

# --- Banco (PostgreSQL) ---
# Em produção: URL COM pooler (modo transação) para o app.
DATABASE_URL=postgres://cz:cz_local@localhost:5432/cz_dev
# Opcional: URL direta (sem pooler) para migrations e scripts. A Neon injeta
# DATABASE_URL_UNPOOLED, que também é aceita.
# DATABASE_URL_DIRETA=

# --- Fotos ---
# Na Vercel: conecte um Blob store público ao projeto (injeta BLOB_READ_WRITE_TOKEN);
# com ele, as variáveis S3 abaixo são ignoradas. Local: S3 do docker-compose.
# BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=http://localhost:9000
S3_REGIAO=us-east-1
S3_BUCKET=cz-dev
S3_ACCESS_KEY_ID=czlocal
S3_SECRET_ACCESS_KEY=czlocal-secret
S3_FORCE_PATH_STYLE=true
# URL pública de leitura do bucket (sem barra no fim). Lida no BUILD (next.config.ts).
FOTOS_URL_PUBLICA=http://localhost:9000/cz-dev
# Só local: deixa o next/image otimizar fotos de localhost. NUNCA em produção.
IMAGENS_HOST_LOCAL=true

# --- E-mail (SMTP) ---
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_SEGURO=false
# SMTP_USUARIO=
# SMTP_SENHA=
EMAIL_DE=Carneiro & Ziller <painel@localhost>

# --- Site ---
# Endereço público, usado nos links dos e-mails. Na Vercel é opcional: sem ele,
# vale o domínio de produção do projeto.
SITE_URL=http://localhost:3000

# --- Deploy (só na Vercel, ambiente Production) ---
# Primeiro ADMIN: criado no deploy e convidado por e-mail (exige SMTP). Sem senha.
# ADMIN_INICIAL_NOME=
# ADMIN_INICIAL_EMAIL=
# Opcional: endereços extras que recebem os avisos de interesse (separados por vírgula).
# LEADS_EMAIL=
# Opcional: protege o cron diário de limpeza (a Vercel envia o segredo sozinha).
# CRON_SECRET=
# Opcional: aplica migrations também em preview (quando o preview tem banco próprio).
# MIGRAR_NO_PREVIEW=true
